@page
@model IncidentHub.Web.Pages.Incidents.CreateModel
@{
    ViewData["Title"] = "Signaler un incident";
}

<h1>Signaler un incident</h1>

@* method="post" : le tag helper <form> ajoute un champ caché
   __RequestVerificationToken (jeton anti-falsification, voir Edit). *@
<form method="post" style="max-width: 40rem">
    @* Erreurs qui ne concernent pas un champ précis (ModelOnly). *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        @* asp-for : génère id, name="Input.Title", la valeur actuelle
           et le libellé [Display(Name = "Titre")]. *@
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        @* asp-validation-for : affiche le message d'erreur de CE champ. *@
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Severity" class="form-label"></label>
        <select asp-for="Input.Severity" class="form-select">
            @foreach (var severity in Enum.GetValues<Severity>())
            {
                <option value="@severity">@Affichage.Libelle(severity)</option>
            }
        </select>
        <span asp-validation-for="Input.Severity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ReporterId" class="form-label"></label>
        <select asp-for="Input.ReporterId" asp-items="Model.Reporters" class="form-select">
            <option value="">-- Choisir --</option>
        </select>
        <span asp-validation-for="Input.ReporterId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Signaler</button>
    <a asp-page="Index" class="btn btn-link">Annuler</a>
</form>
